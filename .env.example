# Configuração Geral do Radar de Compras Públicas
APP_NAME="Radar de Compras Públicas"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# URLs
APP_URL=http://localhost:8080
GO_API_URL=http://localhost:8000

# Chave Interna de Integração Server-to-Server (não expor no frontend)
RADAR_INTERNAL_TOKEN=radar-token-interno-ultra-seguro-compartilhado-com-painel

# Banco de Dados PostgreSQL (schemas separados: painel e api_go)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=radar_compras
DB_USERNAME=radar_user
DB_PASSWORD=radar_password_segura_123
DB_SSLMODE=disable

# Schemas
DB_SCHEMA_PAINEL=painel
DB_SCHEMA_GO=api_go
